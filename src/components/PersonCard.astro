---
import type { CollectionEntry } from 'astro:content'
import { Image } from 'astro:assets'

interface Props {
  entry: CollectionEntry<'people'>
  compact?: boolean
}

const { entry, compact = false } = Astro.props
const { name, role, location, tags, asifsTake, avatar } = entry.data

const takeExcerpt = asifsTake.length > 140 ? asifsTake.slice(0, 137) + '…' : asifsTake
---

<a
  href={`/people/${entry.slug}`}
  class:list={[
    'group block bg-surface rounded-lg p-5 hover:border-border/60 border border-transparent hover:border-accent/20 transition-all duration-300',
    compact ? 'h-full' : '',
  ]}
>
  <div class="flex items-start gap-3 mb-3">
    <div class="shrink-0 w-10 h-10 rounded-full bg-border overflow-hidden">
      {
        avatar ? (
          <Image
            src={avatar}
            alt={name}
            width={80}
            height={80}
            class="w-full h-full object-cover"
          />
        ) : (
          <div class="w-full h-full flex items-center justify-center">
            <span class="text-muted text-sm font-medium">{name.charAt(0)}</span>
          </div>
        )
      }
    </div>
    <div class="flex-1 min-w-0">
      <h3 class="text-fg font-medium group-hover:text-accent transition-colors truncate">
        {name}
      </h3>
      <p class="text-muted text-xs truncate">{role} · {location}</p>
    </div>
  </div>

  {
    !compact && tags.length > 0 && (
      <div class="flex flex-wrap gap-1.5 mb-3">
        {tags.map((tag) => (
          <span class="tag-pill">{tag}</span>
        ))}
      </div>
    )
  }

  <p class="text-muted text-sm leading-relaxed">"{takeExcerpt}"</p>
</a>
