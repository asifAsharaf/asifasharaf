---
import type { CollectionEntry } from 'astro:content'

interface Props {
  entry: CollectionEntry<'writing'>
}

const { entry } = Astro.props
const { title, publishedAt, summary, tags } = entry.data

const dateFormatted = new Intl.DateTimeFormat('en-IN', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
}).format(new Date(publishedAt))
---

<a
  href={`/writing/${entry.slug}`}
  class="group flex flex-col sm:flex-row sm:items-start sm:justify-between gap-2 sm:gap-8 py-6 border-b border-border"
>
  <div class="flex-1">
    <h3 class="font-serif text-xl text-fg group-hover:text-accent transition-colors mb-1">
      {title}
    </h3>
    <p class="text-muted text-sm leading-relaxed">{summary}</p>
    {
      tags.length > 0 && (
        <div class="flex flex-wrap gap-1.5 mt-3">
          {tags.map((tag) => (
            <span class="tag-pill">{tag}</span>
          ))}
        </div>
      )
    }
  </div>

  <time
    datetime={new Date(publishedAt).toISOString()}
    class="text-muted text-sm shrink-0 sm:text-right"
  >
    {dateFormatted}
  </time>
</a>
