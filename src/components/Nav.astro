---
import ThemeToggle from './ThemeToggle.astro'
import { LINKEDIN_URL } from '../lib/social'

const pathname = Astro.url.pathname

const links = [
  { href: '/work', label: 'Work' },
  { href: '/writing', label: 'Writing' },
  { href: '/people', label: 'People' },
  { href: '/about', label: 'About' },
]
---

<header class="w-full px-6 sm:px-8 py-6">
  <div class="container-page flex items-center justify-between">
  <a
    href="/"
    class="text-fg hover:text-accent transition-colors text-sm uppercase tracking-[0.18em] font-medium"
    aria-label="Asif Asharaf — home"
  >
    Asif Asharaf
  </a>

  <nav aria-label="Main navigation" class="flex items-center gap-4 sm:gap-8">
    <ul class="hidden sm:flex items-center gap-6 sm:gap-8">
      {
        links.map((link) => {
          const isActive = pathname.startsWith(link.href)
          return (
            <li>
              <a
                href={link.href}
                class:list={[
                  'text-sm tracking-wide transition-colors',
                  isActive ? 'text-fg' : 'text-muted hover:text-fg',
                ]}
              >
                {link.label}
              </a>
            </li>
          )
        })
      }
    </ul>

    <ThemeToggle />

    <a
      href={LINKEDIN_URL}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center gap-1.5 text-sm uppercase tracking-[0.14em] border border-border hover:border-accent hover:text-accent text-fg px-4 py-2 rounded-full transition-colors"
      aria-label="Connect with Asif on LinkedIn"
    >
      <!-- LinkedIn icon -->
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="13"
        height="13"
        viewBox="0 0 24 24"
        fill="currentColor"
        aria-hidden="true"
        class="shrink-0"
      >
        <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
      </svg>
      <span class="hidden sm:inline">Let's connect</span>
    </a>
  </nav>
  </div>
</header>
