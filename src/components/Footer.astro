---
import { LINKEDIN_URL, INSTAGRAM_URL, EMAIL } from '../lib/social'

const year = new Date().getFullYear()
---

<footer class="border-t border-border mt-24 px-6 sm:px-8 py-12">
  <div class="container-page">
    <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6 mb-8">
      <p class="text-muted text-sm">
        © {year} Asif Asharaf. All rights reserved.
      </p>

      <nav aria-label="Social links">
        <ul class="flex items-center gap-6">
          <li>
            <a
              href={LINKEDIN_URL}
              target="_blank"
              rel="noopener noreferrer"
              class="text-muted hover:text-fg text-sm transition-colors"
            >
              LinkedIn
            </a>
          </li>
          <li>
            <a
              href={INSTAGRAM_URL}
              target="_blank"
              rel="noopener noreferrer"
              class="text-muted hover:text-fg text-sm transition-colors"
            >
              Instagram
            </a>
          </li>
          <li>
            <a
              href={`mailto:${EMAIL}`}
              class="text-muted hover:text-fg text-sm transition-colors"
            >
              Email
            </a>
          </li>
        </ul>
      </nav>
    </div>

    <!-- Quiet links row -->
    <div class="flex items-center gap-6 pt-6 border-t border-border/50">
      <a
        href="/people"
        class="text-muted/60 hover:text-muted text-xs tracking-wide transition-colors"
      >
        People I Respect
      </a>
      <span class="text-border text-xs">·</span>
      <a
        href="/jobs"
        class="text-muted/60 hover:text-muted text-xs tracking-wide transition-colors"
      >
        Jobs & Opportunities
      </a>
    </div>
  </div>
</footer>
