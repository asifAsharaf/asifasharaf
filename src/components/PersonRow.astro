---
import type { CollectionEntry } from 'astro:content'
import { Image } from 'astro:assets'

interface Props {
  entry: CollectionEntry<'people'>
}

const { entry } = Astro.props
const { name, role, location, url, tags, avatar } = entry.data
const cleanUrl = url.replace(/^https?:\/\//, '').replace(/\/$/, '')
---

<a
  href={`/people/${entry.slug}`}
  class="group grid grid-cols-[auto_1fr_auto] md:grid-cols-[auto_minmax(0,1fr)_auto_auto] items-center gap-x-5 sm:gap-x-8 py-5 border-b border-dashed border-border hover:bg-surface/30 -mx-3 px-3 rounded-sm transition-colors"
>
  <!-- Avatar -->
  <div class="shrink-0 w-11 h-11 rounded-full bg-surface overflow-hidden border border-border">
    {
      avatar ? (
        <Image
          src={avatar}
          alt={name}
          width={88}
          height={88}
          class="w-full h-full object-cover"
        />
      ) : (
        <div class="w-full h-full flex items-center justify-center">
          <span class="font-serif text-muted text-sm">{name.charAt(0)}</span>
        </div>
      )
    }
  </div>

  <!-- Name + location + URL -->
  <div class="min-w-0">
    <div class="flex items-baseline gap-2 flex-wrap">
      <span class="font-medium text-fg group-hover:text-accent transition-colors truncate">
        {name}
      </span>
      <span class="text-muted text-sm">
        <span class="italic">from</span> {location}
      </span>
    </div>
    <div class="text-muted text-sm mt-0.5 truncate">{cleanUrl}</div>
  </div>

  <!-- Tags -->
  <div class="hidden md:flex gap-1.5 shrink-0 justify-end">
    {tags.slice(0, 3).map((tag) => <span class="tag-pill">{tag}</span>)}
  </div>

  <!-- Role (the "Overall" column) -->
  <div class="shrink-0 text-right pl-4 md:min-w-[180px]">
    <span class="text-fg font-medium">{role}</span>
  </div>
</a>
