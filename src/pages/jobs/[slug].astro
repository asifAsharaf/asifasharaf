---
export const prerender = true

import BaseLayout from '../../layouts/BaseLayout.astro'
import { getCollection } from 'astro:content'

export async function getStaticPaths() {
  const jobs = await getCollection('jobs')
  return jobs.map((entry) => ({ params: { slug: entry.slug }, props: { entry } }))
}

const { entry } = Astro.props
const { Content } = await entry.render()
const { title, company, location, type, tags, url, salary, postedAt, asifNote } = entry.data

const typeLabel: Record<string, string> = {
  'full-time': 'Full-time',
  'part-time': 'Part-time',
  contract: 'Contract',
  freelance: 'Freelance',
  internship: 'Internship',
}

const formatDate = (d: Date) =>
  new Intl.DateTimeFormat('en-IN', { month: 'long', day: 'numeric', year: 'numeric' }).format(new Date(d))
---

<BaseLayout title={`${title} at ${company} — Jobs`} description={asifNote ?? `${title} at ${company} — ${location}`}>
  <div class="max-w-2xl mx-auto px-6 sm:px-8 py-16 sm:py-24">

    <a href="/jobs" class="text-muted hover:text-fg text-sm transition-colors mb-12 inline-block">
      ← All opportunities
    </a>

    <header class="mb-12" data-reveal>
      <!-- Meta -->
      <div class="flex flex-wrap items-center gap-2 mb-6">
        <span class="tag-pill text-accent border-accent/40">{typeLabel[type]}</span>
        {tags.map((tag) => <span class="tag-pill">{tag}</span>)}
      </div>

      <h1 class="font-serif text-4xl sm:text-5xl text-fg leading-tight mb-2">{title}</h1>
      <p class="text-muted text-xl mb-6">{company}</p>

      <div class="flex flex-wrap gap-6 text-sm text-muted mb-8">
        <span>📍 {location}</span>
        {salary && <span class="text-olive">💰 {salary}</span>}
        <span>🗓 Posted {formatDate(postedAt)}</span>
      </div>

      {asifNote && (
        <div class="border-l-2 border-accent pl-5 py-1 mb-8">
          <p class="text-xs uppercase tracking-widest text-muted mb-2">Asif's note</p>
          <p class="text-fg leading-relaxed italic">"{asifNote}"</p>
        </div>
      )}

      <a
        href={url}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 bg-fg text-bg text-sm font-medium px-6 py-3 rounded-full hover:bg-accent transition-colors"
      >
        Apply / View original →
      </a>
    </header>

    <!-- Body / full JD -->
    <div class="prose-antigravity" data-reveal>
      <Content />
    </div>

  </div>
</BaseLayout>
